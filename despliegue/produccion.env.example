# Plantilla: completar y copiar en privado a backend/.env del servidor.
# Una sola instancia. No contiene credenciales reales.
APP_NAME="Clínica Odontológica UNDAC"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://DOMINIO_PENDIENTE
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=BASE_PRODUCCION_PENDIENTE
DB_USERNAME=USUARIO_LIMITADO_PENDIENTE
DB_PASSWORD=
DB_URL=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=undac_clinica
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
